rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        ('email' in request.auth.token && (
          request.auth.token.email in [
            'admin@roadtok.com',
            'npbagul1991@gmail.com',
            'npbagul@gmail.com',
            'inforoadtok@gmail.com',
            'nileshbagulkhan763100@gmail.com',
            'admin@roadtok.in',
            'admin@khadda.com'
          ] ||
          request.auth.token.email.matches('.*@roadtok[.]com$') ||
          request.auth.token.email.matches('.*@roadtok[.]in$')
        ))
      );
    }

    // Pothole photos folder:
    // 1. Authenticated users (Anonymous Auth) can upload their own photo (create only)
    // 2. Max size: 300 KB
    // 3. Allowed content types: JPEG, WebP, PNG
    // 4. Clients cannot overwrite or modify files (allow update: if false)
    // 5. Only authorized admins can delete rejected or spam photos
    match /potholes/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size <= 300 * 1024
                    && (request.resource.contentType.matches('image/jpeg') ||
                        request.resource.contentType.matches('image/webp') ||
                        request.resource.contentType.matches('image/png'));
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    match /{allPaths=**} {
      allow read: if false;
      allow write: if isAdmin();
    }
  }
}

