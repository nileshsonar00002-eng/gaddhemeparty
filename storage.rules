rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        ('email' in request.auth.token && (
          request.auth.token.email in [
            'admin@roadtok.com',
            'npbagul1991@gmail.com',
            'npbagul@gmail.com',
            'inforoadtok@gmail.com',
            'nileshbagulkhan763100@gmail.com',
            'admin@roadtok.in',
            'admin@khadda.com'
          ] ||
          request.auth.token.email.matches('.*@roadtok[.]com$') ||
          request.auth.token.email.matches('.*@roadtok[.]in$')
        ))
      );
    }

    // Pothole photos folder:
    // 1. Anyone can view photos on map (allow read: if true)
    // 2. Authenticated citizens can upload to their own folder: potholes/{uid}/{fileName}
    // 3. Authorized admins can upload/edit in potholes/admin/{fileName} or any folder
    // 4. Safe size limit: max 500 KB (citizen client compresses photos to < 180 KB)
    // 5. Allowed image types: WebP, JPEG, PNG
    // 6. Normal citizens cannot overwrite or modify existing photos
    // 7. Deletion is strictly reserved for authorized admins
    match /potholes/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && (request.auth.uid == uid || isAdmin())
                    && request.resource.size <= 500 * 1024
                    && (request.resource.contentType.matches('image/jpeg') ||
                        request.resource.contentType.matches('image/webp') ||
                        request.resource.contentType.matches('image/png'));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /{allPaths=**} {
      allow read: if false;
      allow write: if isAdmin();
    }
  }
}

