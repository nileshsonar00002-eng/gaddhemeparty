rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Check if caller is an authorized Admin (any Email/Password account in Firebase Auth)
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.firebase.sign_in_provider != 'anonymous' &&
         'email' in request.auth.token &&
         request.auth.token.email != null) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }

    // Pothole photos folder:
    // 1. Anyone can view photos on the map (allow read: if true)
    // 2. Anyone can upload pothole photos up to 10 MB
    // 3. Deleting photos is strictly reserved for Admins
    match /potholes/{allPaths=**} {
      allow read: if true;
      allow create: if request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }
    
    // Default fallback: Block any other folders from unauthorized writes
    match /{allPaths=**} {
      allow read: if false;
      allow write: if isAdmin();
    }
  }
}
