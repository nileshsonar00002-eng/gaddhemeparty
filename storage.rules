rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pothole photos folder:
    // 1. Authenticated users (Anonymous Auth) can upload their own photo
    // 2. Max size: 300 KB
    // 3. Allowed content types: JPEG, WebP, PNG
    // 4. Client cannot overwrite or delete files
    match /potholes/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size <= 300 * 1024
                    && (request.resource.contentType.matches('image/jpeg') ||
                        request.resource.contentType.matches('image/webp') ||
                        request.resource.contentType.matches('image/png'));
      allow update, delete: if false;
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
