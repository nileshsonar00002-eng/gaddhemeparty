rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated (Anonymous or registered)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if caller is an authorized Admin (any Email/Password account in Firebase Auth)
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.firebase.sign_in_provider != 'anonymous' &&
         'email' in request.auth.token &&
         request.auth.token.email != null) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }

    // -------------------------------------------------------------
    // 1. Pothole Pins Collection
    // -------------------------------------------------------------
    match /pins/{pinId} {
      // Anyone can read active pins on the map; admins can view all pins
      allow read: if resource == null || resource.data.status == 'active' || isAdmin();
      
      // Citizens (with anonymous auth) and Admins can create new pothole reports
      allow create: if isAuthenticated() &&
        request.resource.data.latitude is number &&
        request.resource.data.longitude is number;

      // Citizens can upvote (+1) or add photos; Admins can moderate
      allow update: if isAuthenticated();

      // STRICT SECURITY: Only verified Admins can delete pins!
      allow delete: if isAdmin();

      // Subcollections:
      match /reporters/{userId} {
        allow read, write: if isAuthenticated();
      }
      match /votes/{userId} {
        allow read, write: if isAuthenticated();
      }
      match /flags/{userId} {
        allow read, write: if isAuthenticated();
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------
    // 2. Anti-Spam & Limits Collections
    // -------------------------------------------------------------
    match /limits/{uid} {
      allow read, write: if isAuthenticated();
    }
    match /ipLimits/{ipHash} {
      allow read, write: if isAuthenticated();
    }
    match /rate_limits/{docId} {
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------
    // 3. Aggregate Stats Collection (Visitors, Bell Rings, Counters)
    // -------------------------------------------------------------
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 4. Leaderboard Collection
    // -------------------------------------------------------------
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. Admin Profiles & Audit Logs
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 6. Default Fallback
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
