rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if caller is an authorized Admin (any Email/Password account in Firebase Auth)
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.firebase.sign_in_provider != 'anonymous' &&
         'email' in request.auth.token &&
         request.auth.token.email != null) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('role' in request.auth.token && request.auth.token.role == 'admin')
      );
    }

    // -------------------------------------------------------------
    // 1. Pothole Pins Collection
    // -------------------------------------------------------------
    match /pins/{pinId} {
      // Anyone can view active pothole pins on the map
      allow read: if true;
      
      // Citizens can report potholes with valid GPS coordinates
      allow create: if request.resource.data.latitude is number &&
                       request.resource.data.longitude is number;

      // Citizens can upvote (+1) or attach photos; Admins can moderate
      allow update: if true;

      // STRICT SECURITY: Only verified Admins can delete pins!
      allow delete: if isAdmin();

      // Subcollections:
      match /reporters/{userId} {
        allow read, write: if true;
      }
      match /votes/{userId} {
        allow read, write: if true;
      }
      match /flags/{userId} {
        allow read, write: if true;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------
    // 2. Anti-Spam & Limits Collections
    // -------------------------------------------------------------
    match /limits/{uid} {
      allow read, write: if true;
    }
    match /ipLimits/{ipHash} {
      allow read, write: if true;
    }
    match /rate_limits/{docId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 3. Aggregate Stats Collection (Visitors, Bell Rings, Counters)
    // -------------------------------------------------------------
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 4. Leaderboard Collection
    // -------------------------------------------------------------
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. Admin Profiles & Audit Logs
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 6. Default Fallback (Block everything else)
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
