{
  "name": "khaddawaliparty-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for KhaddaWaliParty backend",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.1",
    "ngeohash": "^0.6.3",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/sanitize-html": "^2.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "private": true
}
